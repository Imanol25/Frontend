# ==============================================================================
# Dockerfile Multi-Stage para Producción (Nginx Alpine optimizado)
# ==============================================================================

# ------------------------------------------------------------------------------
# Etapa 1: Compilación de Assets (Build Stage)
# ------------------------------------------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /app

# Copiar manifiestos de dependencias
COPY package*.json ./
RUN npm install

# Copiar el código fuente completo
COPY . .

# Argumento para inyectar la URL de la API durante el build si es necesario
ARG VITE_API_URL=http://localhost:4000/api/v1
ENV VITE_API_URL=$VITE_API_URL

# Compilar la aplicación React para producción
RUN npm run build

# ------------------------------------------------------------------------------
# Etapa 2: Servidor Web Ultraligero (Nginx Alpine)
# ------------------------------------------------------------------------------
FROM nginx:stable-alpine

# Eliminar configuración por defecto de Nginx
RUN rm -rf /etc/nginx/conf.d/default.conf

# Copiar la configuración personalizada de Nginx para SPA
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copiar los archivos estáticos generados en la etapa de build
COPY --from=builder /app/dist /usr/share/nginx/html

# Exponer el puerto 80 estándar
EXPOSE 80

# Iniciar Nginx en primer plano
CMD ["nginx", "-g", "daemon off;"]

